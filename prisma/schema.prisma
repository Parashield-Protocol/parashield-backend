generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Policy {
  id            String    @id @default(uuid())
  productId     String
  product       Product   @relation(fields: [productId], references: [id])
  policyholder  String
  coverageXlm   Decimal   @db.Decimal(20, 7)
  premiumPaid   Decimal   @db.Decimal(20, 7)
  oracleKey     String
  startTime     DateTime
  endTime       DateTime
  status        PolicyStatus @default(ACTIVE)
  txHash        String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  claims        Claim[]

  @@unique([policyholder, productId, oracleKey])
  @@unique([txHash])
  @@index([policyholder])
  @@index([status])
}

model Product {
  id           String        @id @default(uuid())
  name         String
  category     String
  triggerType  String
  threshold    Decimal       @db.Decimal(20, 7)
  comparison   String
  coverageMin  Decimal       @db.Decimal(20, 7)
  coverageMax  Decimal       @db.Decimal(20, 7)
  premiumRate  Int
  maxDuration  Int
  status       ProductStatus @default(ACTIVE)
  policies     Policy[]

  @@index([category])
}


model Claim {
  id             String     @id @default(uuid())
  policyId       String
  policy         Policy     @relation(fields: [policyId], references: [id])
  claimant       String
  coverageAmount Decimal    @db.Decimal(20, 7)
  payoutAmount   Decimal?   @db.Decimal(20, 7)
  triggerMet     Boolean    @default(false)
  status         ClaimStatus @default(PENDING)
  txHash         String?
  submittedAt    DateTime   @default(now())
  processedAt    DateTime?
  createdAt      DateTime   @default(now())

  @@unique([txHash])
  @@index([policyId])
  @@index([claimant])
  @@index([status])
}

model OracleReading {
  id          String   @id @default(uuid())
  dataType    String
  key         String
  value       BigInt
  confidence  Int
  source      String
  // Start of the time bucket this reading belongs to (hourly by default).
  // One reading per (key, source, bucket) so repeated cron cycles — including
  // concurrent replicas — converge on a single row instead of appending.
  bucketStart DateTime @default(now())
  // Set atomically by the worker before the on-chain call so only one replica
  // per bucket can submit the reading to the Oracle Verifier contract.
  onChainSubmitted Boolean @default(false)
  onChainTxHash    String?
  submittedAt DateTime @default(now())

  @@index([key])
  @@index([dataType, submittedAt])
  @@unique([key, source, bucketStart], name: "key_source_bucket")
}

enum PolicyStatus {
  ACTIVE
  EXPIRED
  CANCELLED
  CLAIMED
  // #164/#166: transient atomic-gate state between ACTIVE and CLAIMED, set by
  // ClaimsService.autoProcess so a concurrent call reading the same ACTIVE
  // snapshot loses the race before any oracle read or contract call happens.
  PROCESSING
}

enum ClaimStatus {
  PENDING
  PROCESSING
  PAID
  REJECTED
  FAILED
  EXPIRED
}

enum ProductStatus {
  ACTIVE
  INACTIVE
  DEPRECATED
}

model AuthChallenge {
  walletAddress String   @id
  nonce         String
  expiresAt     DateTime
  createdAt     DateTime @default(now())

  @@index([expiresAt])
}
